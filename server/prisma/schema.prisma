generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

enum Role {
  ADMIN
  DIRECTOR
  MANAGER
  TEAM_LEADER
  TEAM_MEMBER
  PERSONNEL
}

enum UserStatus {
  ACTIVE
  PENDING
  BANNED
  SUSPENDED
}

enum BoardRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_UPDATED
  COMMENT_RECEIVED
  MEMBER_INVITED
  BOARD_SHARED
  DUE_DATE_REMINDER
  AI_SUGGESTION
  MESSAGE_RECEIVED
  ROLE_CHANGED
  TEAM_JOINED
  BROADCAST
  AUTOMATION_TRIGGERED
}

enum ActivityType {
  BOARD_CREATED
  BOARD_UPDATED
  BOARD_DELETED
  TASK_CREATED
  TASK_UPDATED
  TASK_MOVED
  TASK_DELETED
  COMMENT_ADDED
  MEMBER_ADDED
  MEMBER_REMOVED
  AUTOMATION_TRIGGERED
}

enum AutomationTrigger {
  TASK_STALE_3D
  TASK_OVERDUE
  TASK_HIGH_PRIORITY
  TASK_NO_ASSIGNEE
  BOARD_NO_ACTIVITY_7D
}

enum AutomationAction {
  NOTIFY_TEAM
  ASSIGN_TO_LEADER
  MOVE_TO_REVIEW
  CHANGE_PRIORITY
}

enum MoodLevel {
  GREAT
  GOOD
  OKAY
  STRESSED
  OVERWHELMED
}

enum ConversationType {
  DIRECT
  GROUP
  TEAM
  DEPARTMENT
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String
  password      String
  avatar        String?
  bio           String?
  role          Role           @default(PERSONNEL)
  status        UserStatus     @default(PENDING)
  emailVerified DateTime?
  lastLoginAt   DateTime?
  preferences   Json?
  departmentId  String?
  department    Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  teamId        String?
  team          Team?          @relation(fields: [teamId], references: [id], onDelete: SetNull)
  directedDepartments Department[] @relation("DepartmentDirector")
  ledTeams           Team[]       @relation("TeamLeader")
  boards       Board[]
  boardMembers BoardMember[]
  tasks        Task[]
  comments     Comment[]
  activity     Activity[]
  notifications Notification[]
  sentNotifications Notification[] @relation("NotificationFromUser")
  sentMessages       Message[]      @relation("MessageSender")
  receivedMessages   Message[]      @relation("MessageRecipient")
  conversationMembers ConversationMember[]
  focusSessions      FocusSession[]
  automations        Automation[]
  moodCheckins       MoodCheckin[]
  timeEntries        TimeEntry[]
  userSettings       UserSettings?
  tokenVersion      Int            @default(1)
  deletedAt    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  refreshTokens     RefreshToken[]
  achievements      UserAchievement[]
  level             UserLevel?
  recurringTasks    RecurringTask[]
  auditLogs         AuditLog[]

  @@index([departmentId])
  @@index([teamId])
  @@index([role])
  @@index([status])
  @@map("users")
}

model Board {
  id           String       @id @default(cuid())
  title        String
  description  String?
  color        String       @default("#6366f1")
  isPrivate    Boolean      @default(false)
  ownerId      String
  owner        User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members      BoardMember[]
  columns      Column[]
  tasks        Task[]
  activity     Activity[]
  automations  Automation[]
  timeEntries  TimeEntry[]
  recurringTasks RecurringTask[]
  customFields  CustomField[]
  deletedAt    DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([ownerId])
  @@map("boards")
}

model BoardMember {
  id        String    @id @default(cuid())
  boardId   String
  userId    String
  role      BoardRole @default(MEMBER)
  invitedBy String?
  joinedAt  DateTime  @default(now())
  board     Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([boardId, userId])
  @@index([userId])
  @@index([boardId])
  @@map("board_members")
}

model Column {
  id       String   @id @default(cuid())
  title    String
  status   TaskStatus
  boardId  String
  board    Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks    Task[]
  order    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([boardId])
  @@map("columns")
}

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?
  priority    TaskPriority @default(MEDIUM)
  status      TaskStatus   @default(TODO)
  tags        String[]
  dueDate     DateTime?
  position    Int          @default(0)
  boardId     String
  board       Board        @relation(fields: [boardId], references: [id], onDelete: Cascade)
  columnId    String?
  column      Column?      @relation(fields: [columnId], references: [id], onDelete: SetNull)
  assigneeId  String?
  assignee    User?        @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  comments    Comment[]
  activity    Activity[]
  focusSessions FocusSession[]
  aiGenerated Boolean      @default(false)
  aiPriority  String?
  aiTags      String[]
  deletedAt   DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  blockingTasks   TaskDependency[] @relation("BlockingTasks")
  blockedByTasks  TaskDependency[] @relation("BlockedByTasks")
  customFieldValues CustomFieldValue[]

  @@index([boardId])
  @@index([columnId])
  @@index([assigneeId])
  @@index([status])
  @@index([priority])
  @@index([dueDate])
  @@map("tasks")
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId])
  @@index([userId])
  @@map("comments")
}

model Activity {
  id          String      @id @default(cuid())
  type        ActivityType
  description String
  boardId     String
  board       Board       @relation(fields: [boardId], references: [id], onDelete: Cascade)
  taskId      String?
  task        Task?       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())

  @@index([boardId])
  @@index([taskId])
  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@map("activities")
}

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  data      Json?
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromUserId String?
  fromUser  User?            @relation("NotificationFromUser", fields: [fromUserId], references: [id], onDelete: SetNull)
  boardId   String?
  taskId    String?
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([type])
  @@map("notifications")
}

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  directorId  String?
  director    User?    @relation("DepartmentDirector", fields: [directorId], references: [id], onDelete: SetNull)
  teams       Team[]
  members     User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([directorId])
  @@map("departments")
}

model Team {
  id           String   @id @default(cuid())
  name         String   @unique
  description  String?
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  leaderId     String?
  leader       User?    @relation("TeamLeader", fields: [leaderId], references: [id], onDelete: SetNull)
  members      User[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([departmentId])
  @@index([leaderId])
  @@map("teams")
}

model Conversation {
  id        String             @id @default(cuid())
  type      ConversationType   @default(DIRECT)
  title     String?
  avatar    String?
  members   ConversationMember[]
  messages  Message[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([type])
  @@map("conversations")
}

model ConversationMember {
  id              String       @id @default(cuid())
  conversationId  String
  userId          String
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt      DateTime?
  joinedAt        DateTime     @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([conversationId])
  @@map("conversation_members")
}

model Message {
  id              String        @id @default(cuid())
  content         String
  conversationId  String
  conversation    Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId        String
  sender          User          @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId     String?
  recipient       User?         @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: SetNull)
  status          MessageStatus @default(SENT)
  attachments     Json?
  createdAt       DateTime      @default(now())

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@index([recipientId])
  @@map("messages")
}

model FocusSession {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId      String?
  task        Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  taskTitle   String?
  duration    Int
  completed   Boolean  @default(false)
  startedAt   DateTime @default(now())
  endedAt     DateTime?

  @@index([userId])
  @@index([taskId])
  @@map("focus_sessions")
}

model Automation {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  boardId     String?
  board       Board?           @relation(fields: [boardId], references: [id], onDelete: Cascade)
  name        String
  enabled     Boolean          @default(true)
  trigger     AutomationTrigger
  triggerConfig Json?
  action      AutomationAction
  actionConfig  Json?
  lastFiredAt DateTime?
  fireCount   Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([userId])
  @@index([boardId])
  @@index([enabled])
  @@map("automations")
}

model MoodCheckin {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  mood      MoodLevel
  note      String?
  stress    Int?
  workload  Int?
  createdAt DateTime   @default(now())

  @@index([userId, createdAt])
  @@map("mood_checkins")
}

model TimeEntry {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskTitle   String
  boardId     String?
  board       Board?   @relation(fields: [boardId], references: [id], onDelete: SetNull)
  duration    Int      @default(0)
  description String?
  billable    Boolean  @default(true)
  hourlyRate  Decimal? @db.Decimal(10, 2)
  tags        String[] @default([])
  date        DateTime @default(now())
  startedAt   DateTime?
  endedAt     DateTime?
  isRunning   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([userId, date])
  @@index([userId, isRunning])
  @@index([boardId])
  @@map("time_entries")
}

model UserSettings {
  id                   String   @id @default(cuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgName              String?  @db.VarChar(255)
  orgDomain            String?  @db.VarChar(255)
  timezone             String?  @db.VarChar(100)
  language             String?  @db.VarChar(10)
  defaultBoardColor    String?  @db.VarChar(7)
  autoArchiveDays      Int      @default(30)
  allowGuestAccess     Boolean  @default(false)
  requireApproval      Boolean  @default(true)
  emailNotifications   Boolean  @default(true)
  pushNotifications    Boolean  @default(true)
  taskAssigned         Boolean  @default(true)
  taskDueSoon          Boolean  @default(true)
  taskOverdue          Boolean  @default(true)
  boardUpdates         Boolean  @default(true)
  teamPulseReminders   Boolean  @default(true)
  aiBriefingDaily      Boolean  @default(true)
  weeklyDigest         Boolean  @default(false)
  mentionsOnly         Boolean  @default(false)
  density              String   @default("comfortable") @db.VarChar(20)
  accentColor          String   @default("cyan") @db.VarChar(20)
  reduceMotion         Boolean  @default(false)
  highContrast         Boolean  @default(false)
  twoFactor            Boolean  @default(false)
  sessionTimeout       String   @default("30") @db.VarChar(10)
  passwordExpiry       String   @default("90") @db.VarChar(10)
  ipWhitelist          String?  @db.Text
  apiAccess            Boolean  @default(true)
  auditLog             Boolean  @default(true)
  intSlack             Boolean  @default(false)
  intGithub            Boolean  @default(false)
  intGoogleCalendar    Boolean  @default(false)
  intWebhooks          Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("user_settings")
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  userAgent String?   @db.VarChar(255)
  ip        String?   @db.VarChar(45)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

enum AchievementType {
  FIRST_TASK
  TASKS_10
  TASKS_50
  TASKS_100
  STREAK_7
  STREAK_30
  POMODORO_MASTER
  EARLY_BIRD
  NIGHT_OWL
  TEAM_PLAYER
  SPEED_RUNNER
  ORGANIZER
  COMMUNICATOR
  FOCUS_GURU
  PERFECTIONIST
}

model Achievement {
  id          String          @id @default(cuid())
  type        AchievementType @unique
  name        String
  description String
  icon        String
  xpReward    Int
  threshold   Int
  createdAt   DateTime        @default(now())

  userAchievements UserAchievement[]

  @@map("achievements")
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  unlockedAt    DateTime    @default(now())

  @@unique([userId, achievementId])
  @@index([userId])
  @@index([achievementId])
  @@map("user_achievements")
}

model UserLevel {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  xp           Int      @default(0)
  level        Int      @default(1)
  streak       Int      @default(0)
  lastActiveAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("user_levels")
}

model TaskDependency {
  id           String @id @default(cuid())
  taskId       String
  task         Task   @relation("BlockedByTasks", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOnId  String
  dependsOn    Task   @relation("BlockingTasks", fields: [dependsOnId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@unique([taskId, dependsOnId])
  @@index([taskId])
  @@index([dependsOnId])
  @@map("task_dependencies")
}

model RecurringTask {
  id          String   @id @default(cuid())
  boardId     String
  board       Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  title       String
  description String?
  priority    String   @default("MEDIUM")
  columnId    String?
  assigneeId  String?
  frequency   String
  interval    Int      @default(1)
  nextRunAt   DateTime
  lastRunAt   DateTime?
  isActive    Boolean  @default(true)
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([boardId])
  @@index([nextRunAt])
  @@index([isActive])
  @@map("recurring_tasks")
}

model CustomField {
  id          String   @id @default(cuid())
  boardId     String
  board       Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  name        String
  type        String
  options     String[]
  required    Boolean  @default(false)
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  values      CustomFieldValue[]

  @@index([boardId])
  @@map("custom_fields")
}

model CustomFieldValue {
  id          String   @id @default(cuid())
  customFieldId String
  customField   CustomField @relation(fields: [customFieldId], references: [id], onDelete: Cascade)
  taskId       String
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  value        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([customFieldId, taskId])
  @@index([taskId])
  @@index([customFieldId])
  @@map("custom_field_values")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action     String
  entity     String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([entity])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}
